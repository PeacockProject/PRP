# PRP device config: Xiaomi Redmi Note 8 (ginkgo, SM6125 / Snapdragon 665)
#
# Mainline target, same model as daisy: PeacockProject/linux_sm6125_ginkgo
# (7.2-rc2, branch `ginkgo`) built by linux-xiaomi-ginkgo-prp.
#
# Two things make this simpler than daisy:
#   - lk2nd has no SM6125 port, so there is no split-boot dance. The stock
#     Qualcomm ABL loads the boot image directly.
#   - ginkgo is NOT A/B and has a real 64 MiB `recovery` partition, so PRP is
#     flashed there and left alone.
#
# The DTB is APPENDED to Image.gz by the kernel port (the port emits a single
# `zImage`). ABL finds it by matching the qcom,msm-id / qcom,board-id that the
# ginkgo DTS carries for exactly this purpose — do not pass DTB_IMAGE here, and
# do not switch to a header-v2 --dtb payload without re-testing that match.

TARGET_NAME="xiaomi-ginkgo"
TARGET_ARCH="aarch64"
# Keep the boot image board field empty (ginkgo recovery images ship it empty).
BOARD_NAME=""

IS_MSM="1"
# SM6125 display is drm/msm (MDSS DSI + simple-framebuffer handoff), not the
# legacy msm_fb stack — the Qualcomm framebuffer refresher does not apply.
IS_MSM_FB_REFRESHER="0"
# No lk2nd for SM6125.
IS_MSM_LK2ND_SPLIT_BOOT="0"

# Boot image geometry from the ginkgo recovery device trees (all agree).
# Note the 4096 pagesize — ginkgo is not the 2048 legacy layout.
# The DTS sets stdout-path=serial0:115200n8, so console= here is belt-and-braces
# for bring-up; ramoops is described in the DT and needs no cmdline.
# console=tty0 matters: ttyMSM0 is UART on test points, so without a tty0 console
# there is NO way to see kernel messages on a sealed device. fbcon is built in,
# and init's silence_text_consoles() blanks the console before the GUI takes the
# framebuffer (TEXT_CONSOLE_LOG=0), so this costs nothing on a normal boot but
# makes DEBUG_BOOT=1 actually readable.
# arm-smmu.disable_bypass=0 is THE load-bearing flag for the display.
#
# PRP renders via simpledrm into the framebuffer ABL programmed at
# framebuffer@5c000000. The display block keeps DMA-ing from that region, but it
# is not attached to any iommu domain (drm/msm is off, so nothing claims it).
# Once the ARM SMMU driver takes over, unmatched stream IDs fault by default and
# every fetch aborts:
#
#   arm-smmu c600000.iommu: Unhandled context fault: fsr=0x402 [Format=2 TF],
#                           iova=0x5c003000, SID=0x400
#
# — iova lands inside framebuffer_mem. Result: backlight on, /dev/fb0 writable,
# GUI running, nothing on screen.
#
# iommu.passthrough=1 is the one that matters: this is a CONTEXT fault (cb=5),
# not an unknown-stream fault, so the display block already has a translating
# domain. IOMMU_DMA gives any DT node with an `iommus` property a default domain
# even when no driver binds it, which replaces ABL's identity mapping. Passthrough
# makes default domains identity, so the bootloader's scanout keeps working.
# arm-smmu.disable_bypass=0 covers the unmatched-stream case and is kept as belt
# and braces; on its own it did NOT fix this.
#
# clk_ignore_unused / pd_ignore_unused keep the clock and power-domain framework
# from reaping what ABL left running, for the same reason (nothing claims them).
# regulator_ignore_unused proved unnecessary — the rails were never on — but is
# harmless and cheap insurance while drm/msm is disabled.
CMDLINE="console=tty0 console=ttyMSM0,115200n8 clk_ignore_unused pd_ignore_unused regulator_ignore_unused loglevel=7 printk.devkmsg=on panic=3"
BASE="0x00000000"
KERNEL_OFFSET="0x00008000"
# 0x01000000 (16 MiB) is the stock ginkgo value and is fine for a ~15 MB kernel,
# but a larger kernel overruns the ramdisk load address and ABL silently drops
# back to the bootloader instead of booting. 22 MB kernel + 0x8000 load addr
# exceeds 16 MiB, so give the ramdisk room at 32 MiB.
RAMDISK_OFFSET="0x02000000"
SECOND_OFFSET="0x00f00000"
TAGS_OFFSET="0x00000100"
PAGESIZE="4096"
HEADER_VERSION="1"
# Qualcomm ABL, not Samsung aboot — no SEANDROIDENFORCE footer.
APPEND_SEANDROIDENFORCE="0"

# Kernel comes from the PRP-trimmed mainline port; the port stages `zImage`
# (Image.gz + sm6125-xiaomi-ginkgo.dtb concatenated) for resolve_kernel_image.
KERNEL_PACKAGE="linux-xiaomi-ginkgo-prp"
KERNEL_IMAGE="${KERNEL_IMAGE:-}"
KERNEL_CONFIG="${KERNEL_CONFIG:-/boot/config}"
# Appended, not a separate payload — see the header comment.
DTB_IMAGE=""

# Always build a unique PRP ramdisk.
RAMDISK_PREBUILT=""
RAMDISK_FORMAT="gzip"
INITRAMFS_ROOTFS="initramfs/rootfs"

# Runtime asset sync inputs (legacy sync-assets path only; the feather assembly
# is the real source of truth for the rootfs).
ROOTFS_IMAGE="$HOME/.local/var/peacock/xiaomi-ginkgo.img"
ROOTFS_OFFSET_SECTORS="1050624"
ROOTFS_SIZE_SECTORS="9433088"
BUSYBOX_STATIC="${BUSYBOX_STATIC:-/usr/bin/busybox}"

# Monolithic: fold the PRP rootfs overlay into the initramfs. The recovery
# partition is 64 MiB and the image lands around 23 MiB, so it fits with room
# to spare and there is no separate PRP_ROOTFS partition to carve out.
PRP_MONOLITHIC_INITRAMFS="1"
MOUNT_PRP_ROOTFS="0"
DO_MOUNT_SUBPARTS="0"
SUBPARTS_ASYNC="1"
SUBPARTS_DELAY_SECS="10"

# Peacock userdata image container on ginkgo.
USERDATA_DEV_HINT="/dev/block/bootdevice/by-name/userdata /dev/block/by-name/userdata"
# Unused while monolithic — kept for a future split build.
ROOTFS_DEV_HINT=""

# Non-A/B: flash straight to the dedicated recovery partition. For a throwaway
# test boot without touching flash, `fastboot boot out/xiaomi-ginkgo/prp-*.img`
# works on this ABL.
FLASH_METHOD="fastboot-bootimg"
FASTBOOT_PREFIX="fastboot"
FASTBOOT_PARTITIONS="recovery"
FASTBOOT_AB_LK2ND_SPLIT_BOOT="0"
FASTBOOT_SET_ACTIVE=""
# adb-dd fallback (from a booted stock recovery / TWRP) uses this block device.
ADB_PREFIX="adb"
RECOVERY_BLOCK="/dev/block/bootdevice/by-name/recovery"

# PRP initramfs boots without copied TWRP adbd blobs.
REQUIRE_TWRP_SBIN="0"
USB_SERIAL="PRP-GINKGO"
# dwc3 core node from sm6125.dtsi (usb3_dwc3: usb@4e00000).
USB_UDC_NAME="${USB_UDC_NAME:-4e00000.usb}"
# Empty so init auto-detects the ConfigFS gadget path; pin it if the first boot
# picks the wrong node.
USB_GADGET_PATH="${USB_GADGET_PATH:-}"

# Power key: pm6125 PON pwrkey (&pon_pwrkey), driven by the pm8941-pwrkey
# driver, KEY_POWER = 116. Volume down is the PON resin and volume up is the
# only gpio-keys entry, so the scoring hints must not favour gpio-keys here.
# Pin GUI_POWER_INPUT to an explicit /dev/input/eventN if selection ties.
GUI_POWER_HINT="pm8941_pwrkey pwrkey pon pm6125"
GUI_POWER_CODE="116"

# 1080x2340 panel (NT36672A): render at half res + 2x upscale.
GUI_SCALE="200"

# Display / console behaviour.
ENABLE_FB_IO="1"
USE_FB_REFRESHER="0"
DEBUG_BOOT="${DEBUG_BOOT:-0}"
# Keep the splash/GUI owning the framebuffer; SSH + raw shell stay available.
START_TTY_SHELLS="${START_TTY_SHELLS:-0}"
TEXT_CONSOLE_LOG="${TEXT_CONSOLE_LOG:-0}"
START_SSH="1"
SMOKE_ONLY="0"
# ginkgo has no debug/log partition: find_debug_dev() looks for mmcblk0p53 /
# "logfs", which is the daisy MSM8953 layout. Probing anyway costs 8 x sleep 1
# per debug_snapshot() and DEBUG_READY never latches, so all six snapshot points
# pay it — ~48s of dead time on every boot. Skip it.
PROBE_DEBUG_PARTITION="0"

# Modern ext4 defaults are fine on a 7.x kernel.
DROPBEAR_VER="2022.83"

# --- vendor firmware ----------------------------------------------------------
# firmware-xiaomi-ginkgo on genmirror ships NO blobs by design (they are not
# redistributable); it is an extractor that runs against the phone's own
# partitions at install time. That cannot serve a host-built ramdisk, so PRP
# takes the prebuilt /lib/firmware-shaped tarball from genmirror instead and
# bakes in only what it cannot obtain at runtime.
FIRMWARE_TARBALL_URL="https://genmirror.peacockos.org/firmware/stable/aarch64/ginkgo-firmware.tar.gz"
# Verified 2026-08-04 against the sha256 manifest inside the firmware-xiaomi-ginkgo
# feather: 80/82 files matched, 0 mismatches. The two absent entries are
# regulatory.db/.p7s, which the README states are not vendor firmware and which
# PRP already vendors in firmware/wireless-regdb/.
FIRMWARE_TARBALL_SHA256="2dec2ce05ad0a2897c65a18a033e01bc1d5fbb1dec062f2f65efd15b6e971afa"
# Only the DERIVED blobs get baked in — the ones a runtime mount cannot produce:
#   ath10k/…/board-2*.bin  repackaged from the raw bdf_c3j.bin into ath10k's
#                          board-2 container, keyed variant=Xiaomi_ginkgo
#   ath10k/…/firmware-5.bin  a deliberate 60-byte stub (WCN3990 has no separate
#                          WLAN firmware file; ath10k just insists on opening one)
#   novatek/*.fw           renamed from novatek_ts_*_fw.bin; host-download part,
#                          so no firmware means NO TOUCH and no usable wizard
# Total ~1.3 MiB. Everything else (72 MiB of modem/ADSP PAS images, Venus, the
# zap shader, BT) is either unnecessary for recovery or mounted at runtime below.
#   qcom/sm6125/qupv3fw.elf  QUP serial-engine firmware for geni-se. The touch
#                          controller hangs off spi2, a QUP engine, and the
#                          ginkgo firmware README warns that reading the revision
#                          register of an engine the bootloader never programmed
#                          hangs the config bus hard, with no console output.
#                          64 KiB — cheap insurance on the touch path.
FIRMWARE_INCLUDE="ath10k novatek qcom/sm6125"

# The large remainder, read verbatim off the device's own NON-HLOS partition.
# init mounts it read-only and points firmware_class.path at image/, which is
# where modem.mdt + modem.b* live — matching the bare "modem.mdt" the ginkgo DTS
# sets on &remoteproc_mpss precisely so it resolves under that path.
FW_RUNTIME_PART="modem"
FW_RUNTIME_SUBDIR="image"
FW_RUNTIME_FSTYPE="vfat"
# Left empty on purpose: the MPSS has auto_boot=false and the ginkgo DTS states
# the modem is NOT required for Wi-Fi on this board (the WCN3990 hosts its own
# WLFW subsystem, cf. qcs404). The DTS also records that on the modified test
# unit the modem watchdogs every ~17s. The firmware is now reachable either way;
# set this to "modem.mdt" to actually bring the modem up.
FW_RUNTIME_RPROC_FW=""
